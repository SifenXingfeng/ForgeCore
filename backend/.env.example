# ForgeCore backend environment configuration.
# Copy to .env and adjust values; never commit the real .env.

# ── Database ────────────────────────────────────────────────
POSTGRES_USER=forgecore
POSTGRES_PASSWORD=forgecore_dev
POSTGRES_DB=forgecore
POSTGRES_HOST=localhost
POSTGRES_PORT=5440
DATABASE_URL=postgresql+asyncpg://forgecore:forgecore_dev@localhost:5440/forgecore

# ── Redis ───────────────────────────────────────────────────
REDIS_URL=redis://localhost:6380/0

# ── Auth ────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── CORS ────────────────────────────────────────────────────
# Comma-separated list of allowed origins.
CORS_ORIGINS=http://localhost:4173,http://127.0.0.1:4173

# ── LLM (reserved for B8 agent phase) ───────────────────────
# LLM_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o
# LLM_BASE_URL=https://api.openai.com/v1
# AGENT_LLM_TIMEOUT_SECONDS=15
AGENT_SESSION_TTL_SECONDS=86400

# ── App ─────────────────────────────────────────────────────
APP_ENV=development
APP_LOG_LEVEL=info
